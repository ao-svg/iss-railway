# TheSportsDB API key. '123' is the current free/shared test key (rate-limited, fine for daily fixture pulls).
# Set a real premium key here for livescore.php / v2 API access.
SPORTSDB_API_KEY=123

# Comma-separated TheSportsDB league IDs to pull fixtures for.
# 4790=Liga 1 Indonesia, 4328=Premier League, 4335=La Liga, 4332=Serie A,
# 4331=Bundesliga, 4480=UEFA Champions League,
# 5513=WC Qual AFC, 5518=WC Qual UEFA, 5515=WC Qual CONMEBOL,
# 5516=WC Qual CONCACAF, 5514=WC Qual CAF, 5517=WC Qual OFC
SPORTSDB_LEAGUE_IDS=4790,4328,4335,4332,4331,4480,5513,5518,5515,5516,5514,5517

# Public iptv-org master playlist (freely licensed/self-reported broadcast channels)
IPTV_ORG_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u

# How many days ahead to scrape from wheresthematch.com's public schedule
# (second fixture source — full multi-sport schedule + broadcaster names,
# not capped like TheSportsDB's free tier).
WTM_DAYS=31

# How often to re-run the full pipeline, as a cron expression. Default: every 6 hours.
PIPELINE_CRON=0 */6 * * *

# Port for the CSV/JSON HTTP endpoints
PORT=3000

# Where persistent state (users, settings overrides, source checks,
# screenshots, translations, CSV exports...) is stored. Leave unset on
# Railway and attach a volume instead — RAILWAY_VOLUME_MOUNT_PATH is picked
# up automatically. Unset everywhere = ./data (wiped on Railway redeploys).
# DATA_DIR=

# Where to write the CSV on disk (also served at /fixtures.csv).
# Defaults to fixtures.csv inside the data dir.
# OUTPUT_CSV_PATH=

# Admin dashboard login — HTTP Basic Auth, multi-account. Two roles: 'admin'
# (full access) and 'viewer' (read-only, /browse only). Additional accounts
# (including viewers) are created after first login on the /users page and
# persist in data/users.json, NOT in env vars.
#
# These two vars only seed the FIRST admin account, and only when
# users.json (in the data dir) doesn't exist yet. Once it exists it is
# authoritative and these vars are ignored. With a Railway volume attached
# that means they only matter on the very first boot; without one, the disk
# is wiped on every redeploy so they re-seed the admin each time.
# If you ever get locked out, delete users.json from the data dir and
# restart — a fresh admin account is reseeded from these vars.
#
# /health, /fixtures.csv, /fixtures.json, /live.csv, /live.json stay public
# for all roles. Dashboard is disabled (503) until ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Live-streaming source domain (src/liveTv.js) — "what's live right now",
# separate from the scheduled fixtures above. Blank = feature entirely
# disabled (default). YouTube links found are never treated as usable until
# their uploading channel is manually approved on /youtube-channels — see
# README for why. Non-YouTube links are counted but never resolved to a URL.
LIVETV_DOMAIN=

# Relay service (separate Railway service, see src/relay.js) — proxies HLS
# streams and serves stream thumbnails. RELAY_URL must be the relay's PUBLIC
# domain (browsers load URLs built from it). RELAY_SECRET is sent as
# ?secret= on every relay request except /health. Check the connection at
# /api/relay-status (admin) or in the boot log ("[relay] connected ...").
RELAY_URL=
RELAY_SECRET=
# Optional private-network base for server-to-server calls, e.g.
# http://relay.railway.internal:8080 — only works when both services are in
# the same Railway project. Defaults to RELAY_URL.
# RELAY_INTERNAL_URL=
